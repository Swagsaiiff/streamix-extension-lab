{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StreamixExtensionManifest",
  "description": "Schema definition for Streamix Desktop extension manifests",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "version",
    "description",
    "author",
    "streamixApiVersion",
    "entrypoint",
    "contentTypes",
    "languages",
    "permissions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$",
      "description": "Unique reverse-DNS identifier for the extension, e.g. org.streamix.provider.sample"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable name of the extension"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic versioning (SemVer 2.0.0) of the extension"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short summary of what this extension provides"
    },
    "author": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" },
            "email": { "type": "string" }
          }
        }
      ],
      "description": "Author name or metadata object"
    },
    "streamixApiVersion": {
      "type": "string",
      "pattern": "^(\\^|~)?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Target Streamix Extension API version compatibility (e.g. 1.0.0 or ^1.0.0)"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to entry point JavaScript file (e.g. dist/index.js or src/index.ts in dev)"
    },
    "contentTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["movie", "series", "anime", "live"]
      },
      "description": "Types of media content supported by this extension"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      },
      "description": "List of supported ISO language codes (e.g. ['en', 'hi', 'fr'])"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "network:fetch",
          "storage:local"
        ]
      },
      "description": "Declared runtime permissions required by the extension"
    },
    "icon": {
      "type": "string",
      "description": "Relative path to icon image or URI"
    },
    "repositoryUrl": {
      "type": "string",
      "format": "uri",
      "description": "Source code repository URL"
    },
    "issuesUrl": {
      "type": "string",
      "format": "uri",
      "description": "Bug tracker / issues URL"
    },
    "homepageUrl": {
      "type": "string",
      "format": "uri",
      "description": "Homepage or documentation URL"
    }
  }
}
