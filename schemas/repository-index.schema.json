{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StreamixExtensionRepositoryIndex",
  "description": "Schema definition for Streamix extension repository index (plugins.json)",
  "type": "object",
  "required": [
    "repository",
    "updatedAt",
    "extensions"
  ],
  "additionalProperties": false,
  "properties": {
    "repository": {
      "type": "object",
      "required": ["id", "name", "version", "manifestVersion"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "manifestVersion": {
          "type": "integer",
          "minimum": 1
        },
        "homepageUrl": {
          "type": "string",
          "format": "uri"
        },
        "pluginLists": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of URLs or relative paths pointing to plugin catalog indices (plugins.json)"
        },
        "pluginsUrl": {
          "type": "string",
          "description": "Direct URL or relative path to the plugin catalog index (plugins.json)"
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "version",
          "streamixApiVersion",
          "description",
          "author",
          "contentTypes",
          "languages",
          "packageUrl",
          "packageSha256",
          "packageSizeBytes",
          "permissions",
          "releaseDate"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "version": { "type": "string" },
          "streamixApiVersion": { "type": "string" },
          "description": { "type": "string" },
          "author": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "url": { "type": "string" },
                  "email": { "type": "string" }
                }
              }
            ]
          },
          "contentTypes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string" }
          },
          "packageUrl": {
            "type": "string",
            "description": "Download location URL or relative package path"
          },
          "packageSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Cryptographic SHA-256 integrity hash of the package file"
          },
          "packageSizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "permissions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "icon": {
            "type": "string"
          },
          "releaseDate": {
            "type": "string"
          },
          "changelog": {
            "type": "string"
          }
        }
      }
    }
  }
}
